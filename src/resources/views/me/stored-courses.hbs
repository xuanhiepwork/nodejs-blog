
<div class="mt-4">
    <div>
      <h3>Khóa học của tôi</h3>
      {{!-- Ẩn đi khi thùng rác không có gì --}}
      {{!-- {{#if deletedCount}} 
      <a href="/me/trash/couses">Thùng rác ({{deletedCount}})</a>
      {{/if}} --}}

      <a href="/me/trash/couses">Thùng rác ({{deletedCount}})</a>
      
      <div class="mt-4 d-flex align-items-center">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" value="" id="checkbox-all">
          <label class="form-check-label" for="checkbox-all">
            Chọn tất cả
          </label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" value="" id="defaultCheck2" disabled>
          <label class="form-check-label" for="defaultCheck2">
            Disabled checkbox
          </label>
        </div>

        <select class="form-control form-control-sm checkbox-select-all-options " id="">
          <option>-- Hành động --</option>
          <option value="delete">Xóa</option>
        </select>

        <button class="btn btn-primary btn-sm check-all-submit-btn disabled">Thực hiện</button>
      </div>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col" colspan="2">#</th>
                <th scope="col">Tên khóa học</th>
                <th scope="col">Trình độ</th>
                <th scope="col" colspan="2">Thời gian tạo</th>
            </tr>
        </thead>
        <tbody>
            {{#each courses}}
            <tr>
                <td>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="courseIds[]" value="{{this._id}}">
                  </div>
                </td>

                <th scope="row">{{sum @index 1}}</th>
                <td>{{this.name}}</td>
                <td>{{this.level}}</td>
                <td>{{this.createdAt}}</td>
                <td>
                    <a href="/courses/{{this.slug}}" class="btn btn-primary">Xem</a>
                    <a href="/courses/{{this._id}}/edit" class="btn btn-link">Sửa</a>
                    <a href="" class="btn btn-link" data-toggle="modal" data-id="{{this.id}}" data-target="#delete-course-modal">Xóa</a>
                </td>
            </tr>

            {{else}}
            <tr>
                <td colspan="5" class="text-center">
                  Bạn chưa đăng khóa học. 
                  <a href="/courses/create">Đăng khóa học</a>
                </td>  
            </tr>
            {{/each}}

            {{!-- {{#each courses}}
            <tr>
                <th scope="row">{{@index}}</th>
                <td>{{this.name}}</td>
                <td>{{this.price}}</td>
                <td>
                    <a href="/courses/{{this.slug}}" class="btn btn-primary">Xem</a>
                    <a href="/courses/edit/{{this._id}}" class="btn btn-secondary">Sửa</a>
                    <form action="/courses/delete/{{this._id}}" method="POST" style="display:inline;">
                        <button type="submit" class="btn btn-danger">Xóa</button>
                    </form>
                </td>
            </tr>
            {{/each}} --}}
        </tbody>
</div>


{{!-- Confirm delete course --}}
<div id="delete-course-modal" class="modal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Xóa khóa học</h5>
        <button type="button" class="close" data-dismiss="modal" data-id="{{this._id}}" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <p>Bạn chắc chắn muốn xóa khóa học này?</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-danger">Xóa bỏ</button>
        <button id="btn-delete-course" type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
      </div>
    </div>
  </div>
</div>

{{!-- Delete Hidden Form --}}
<form name="delete-course-form" method="POST"></form>

<script>
    // JavaScript to handle the delete confirmation modal | Dùng DOM để khi nào trình duyệt chạy xong thì nó mới chạy cái DOM này
    document.addEventListener('DOMContentLoaded', function() {
        var courseID;
        var deleteForm = document.forms['delete-course-form'];
        var btnDeleteCourse = document.getElementById('btn-delete-course');
        var checkboxAll = $('#checkbox-all');
        var courseItemCheckbox = $('input[name="courseIds[]"]');
        var checkAllSubmitBtn = $('.check-all-submit-btn');
        
        // When dialog confirm clicked, it should send a DELETE request to the server
        $('#delete-course-modal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget)
            courseID = button.data('id') 
        })
        //console.log(btnDeleteCourse); //Xem có lấy được nút không

        // When the delete button is clicked, it should submit the form with the DELETE method
        btnDeleteCourse.onclick = function() {
            //alert(courseID); // Thông báo xóa thành công
            deleteForm.action = '/courses/' + courseID + '?_method=DELETE'; // Set action to the form
            deleteForm.submit(); 
        }


        // Checkbox all change | Handle the checkbox "Select All" functionality
        // Cách 1: Làm bth
        checkboxAll.on('change', function() {
            var isChecked = $(this).is(':checked');
            $('input[name="courseIds[]"]').prop('checked', isCheckedAll);
        });

        //Cách 2: jQuery
        checkboxAll.change(function() {
            var isChecked = $(this).prop('checked');

            courseItemCheckbox.prop('checked', isCheckedAll);
            // Giải thích cho dòng ở trên | Toggle the "Select All" checkbox based on the state of individual checkboxes
            //if (isCheckedAll) {
                //courseItemCheckbox.prop('checked', true);
            //} else {
                //courseItemCheckbox.prop('checked', false);
            //}

            renderCheckAllSubmitBtn(); 
        });

        // Course item checkbox click event
        courseItemCheckbox.on('change', function() {
            var isCheckedAll = courseItemCheckbox.length === courseItemCheckbox.filter(':checked').length; // Số lượng checkbox được chọn bằng tổng số checkbox | Nếu không thì sẽ disable nút "Thực hiện" chọn tất cả
            checkboxAll.prop('checked', isCheckedAll);
        });

        // Re-render the "Select All" button based on the state of individual checkboxes
        function renderCheckAllSubmitBtn() {
            var checkedCount = courseItemCheckbox.length === courseItemCheckbox.filter(':checked').length;
            //var submitButton = $('.checkbox-select-all-options + .btn');
            if (checkedCount > 0) {
                checkAllSubmitBtn.removeClass('disabled');
            } else {
                checkAllSubmitBtn.addClass('disabled');
            }
        }
    });
</script>
