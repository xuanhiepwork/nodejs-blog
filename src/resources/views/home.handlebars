<h1>{{title}}</h1>
<h1>{{courses}}</h1>

<ul class="courses_ui">
    {{#each courses}}
        <li>{{this.name}}</li>
    {{/each}}   
</ul>


<div class="mt-4">
    <div class="row">

        {{!-- Xác định chỗ lặp cho các khóa học --}}
        {{#each courses}}
        <div class="col-sm-6 col-lg-4">
            <div class="card card-course-item" style="width: 18rem;">
                <img class="card-img-top" src="{{this.image}}" alt="Card image cap">
                <div class="card-body">
                    <h5 class="card-title">{{this.name}}</h5>
                    <p class="card-text">{{this.description}}</p>
                    <a href="#" class="btn btn-primary">Mua khóa học</a>
                </div>
            </div>
        </div>
        {{/each}}
        
    </div>
</div>